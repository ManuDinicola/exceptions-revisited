<Project>

  <!-- Central Package Management: every version lives here, project files only name packages. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0.16 is the first BenchmarkDotNet line that knows net11.0 (RuntimeMoniker.Net11_0). -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
