<Project Sdk="Microsoft.NET.Sdk">

  <!-- Multi-targeted on purpose: the 2024 article measured .NET 8, this compares it with .NET 11.
       Plain C# only (no unions), so it can run on both runtimes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net11.0;net8.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <NoWarn>$(NoWarn);CA1822;CA1515;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

</Project>
